-- Đăng ký 1 dòng vào bảng. GetKey: hàm trả về chữ phím, Run: hàm chạy, GetState: hàm trả true/false (tùy chọn)
function Library:RegisterKeybind(Name, GetKey, Run, GetState)
    for Index, E in ipairs(KeybindEntries) do
        if E.Name == Name then
            if E.Row then E.Row:Destroy() end
            table.remove(KeybindEntries, Index)
            break
        end
    end
    table.insert(KeybindEntries, {
        Name = Name, GetKey = GetKey, Run = Run or function() end, GetState = GetState
    })
    if KbPanel and KbPanel.Parent then RefreshKbPanel() end
end

function Library:ShowKeybindPanel(State)
    BuildKbPanel()
    KbVisible = State and true or false
    KbPanel.Visible = KbVisible
    if KbVisible then RefreshKbPanel() end
end

function Library:ToggleKeybindPanel()
    Library:ShowKeybindPanel(not KbVisible)
end
