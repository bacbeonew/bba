local function FlashTarget(Frame)
    local Stroke = Frame:FindFirstChildOfClass('UIStroke')
        or (Frame.Parent and Frame.Parent:FindFirstChildOfClass('UIStroke'))
    if not Stroke then return end
    local OldThickness = Stroke.Thickness
    Stroke.Color = KbAccent
    Stroke.Thickness = 2
    task.delay(1.4, function()
        if Stroke.Parent then
            Stroke.Color = Theme.UIStrokeColor
            Stroke.Thickness = OldThickness
        end
    end)
end

local function GoToResult(E)
    SearchResults.Visible = false
    local P = E.Frame.Parent
    while P and P ~= Container do
        if P:GetAttribute('IsGroup') then P:SetAttribute('Collapsed', false) end
        P = P.Parent
    end    
    local Switch = TabSwitchers[E.Tab]
    if Switch then Switch() end
    task.spawn(function()
        task.wait(0.1)
        local TabFrame = Container.Main.TabContainer.TabsFolder:FindFirstChild(E.Tab)
        if TabFrame and E.Frame.Parent then
            local S = MainScale.Scale
            if S <= 0 then S = 1 end
            local Y = (E.Frame.AbsolutePosition.Y - TabFrame.AbsolutePosition.Y) / S + TabFrame.CanvasPosition.Y
            TabFrame.CanvasPosition = Vector2.new(0, math.max(Y - 10, 0))
        end
        if E.Frame.Parent then FlashTarget(E.Frame) end
    end)
end

local function RunSearch(Raw)
    ClearSearchRows()
    SearchFound = {}
    local Query = (Raw or ''):lower():gsub('^%s+', ''):gsub('%s+$', '')
    if Query == '' then
        SearchResults.Visible = false
        return
    end

    for _, E in ipairs(SearchIndex) do
        if E.Frame.Parent then
            local N = E.Name:lower()
            local Score
            if N:find(Query, 1, true) == 1 then Score = 1
            elseif N:find(Query, 1, true) then Score = 2
            elseif (E.Tab..' '..E.Section):lower():find(Query, 1, true) then Score = 3 end
            if Score then table.insert(SearchFound, { E = E, Score = Score }) end
        end
    end
    table.sort(SearchFound, function(A, B)
        if A.Score ~= B.Score then return A.Score < B.Score end
        return A.E.Name:lower() < B.E.Name:lower()
    end)

    if #SearchFound == 0 then
        Utility:Create('TextLabel', {
            Name = 'SearchNone',
            Parent = SearchResults,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            Font = Enum.Font.Gotham,
            TextSize = 14,
            Text = 'No results',
            TextColor3 = Theme.SecondaryTextColor,
            ZIndex = 312
        })
        SearchResults.Size = UDim2.new(1, 0, 0, 36)
        SearchResults.Visible = true
        return
    end

    local Shown = math.min(#SearchFound, 30)
    for i = 1, Shown do
        local E = SearchFound[i].E
        local Row = Utility:Create('TextButton', {
            Name = 'SearchRow',
            Parent = SearchResults,
            BackgroundColor3 = Theme.PrimaryElementColor,
            AutoButtonColor = false,
            Text = '',
            Size = UDim2.new(1, 0, 0, 30),
            LayoutOrder = i,
            ZIndex = 312
        }, {
            Utility:Create('UICorner', { CornerRadius = UDim.new(0, 4), Name = 'SearchRowCorner' }),
            Utility:Create('TextLabel', {
                Name = 'RowName',
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 8, 0, 0),
                Size = UDim2.new(0.6, -8, 1, 0),
                Font = Enum.Font.Gotham,
                TextSize = 14,
                Text = E.Name,
                TextColor3 = Theme.PrimaryTextColor,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 313
            }),
            Utility:Create('TextLabel', {
                Name = 'RowPath',
                AnchorPoint = Vector2.new(1, 0),
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -8, 0, 0),
                Size = UDim2.new(0.4, -8, 1, 0),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                Text = E.Tab..'  >  '..E.Section,
                TextColor3 = Theme.SecondaryTextColor,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 313
            })
        })
        Row.MouseEnter:Connect(function() Row.BackgroundColor3 = Utility:Lighten(Theme.PrimaryElementColor) end)
        Row.MouseLeave:Connect(function() Row.BackgroundColor3 = Theme.PrimaryElementColor end)
        Row.MouseButton1Click:Connect(function() GoToResult(E) end)
    end

    SearchResults.Size = UDim2.new(1, 0, 0, math.min(Shown, 6) * 32 + 8)
