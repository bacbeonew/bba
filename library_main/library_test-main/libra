    function Library:ExportTheme()
        local Out = {}
        for Index, Value in next, Theme do
            Out[Index] = Utility:SplitColor(Value)
        end
        local Json = HttpService:JSONEncode(Out)

        local Copy = setclipboard or toclipboard
        if Copy then
            Copy(Json)
            Library:CreateNotification('Theme Exported', 'Theme copied to clipboard.', 5)
        else
            Library:CreateNotification('Export Failed', 'Your executor has no clipboard function.', 5)
        end
        return Json
    end

    function Library:ImportTheme(Json)
        local Ok, Decoded = pcall(function()
            return HttpService:JSONDecode(Json or '')
        end)
        if not Ok or type(Decoded) ~= 'table' then
            Library:CreateNotification('Import Failed', 'The pasted text is not a valid theme.', 5)
            return false
        end

        local NewTheme, Found = {}, 0
        for Index, Current in next, Theme do
            local V = Decoded[Index]
            if type(V) == 'table' and type(V[1]) == 'number' and type(V[2]) == 'number' and type(V[3]) == 'number' then
                NewTheme[Index] = Color3.fromRGB(
                    math.clamp(V[1], 0, 255),
                    math.clamp(V[2], 0, 255),
                    math.clamp(V[3], 0, 255)
                )
                Found += 1
            else
                NewTheme[Index] = Current   -- thiếu màu nào thì giữ màu cũ
            end
        end

        if Found == 0 then
            Library:CreateNotification('Import Failed', 'No valid theme colors were found.', 5)
            return false
        end

        Library:ChangeTheme(NewTheme)
        Library:CreateNotification('Theme Imported', 'Applied '..Found..' theme colors.', 5)
        return true
    end
