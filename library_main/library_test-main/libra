-- các thành phần KHÔNG bị làm mờ (khớp theo đuôi tên)
local ProtectedSuffix = {
    'Toggle',            -- nút gạt
    'SliderButton',      -- thanh slider thường
    'SliderTrail',       -- phần màu của slider
    'RowTrack',          -- thanh slider trong Slider Group
    'RowTrail',          -- phần màu của slider trong Slider Group
    'KeyBox',            -- ô keybind trên toggle
    'Keybind',           -- ô keybind (CreateKeybind)
    'Textbox',           -- ô nhập chữ
    'TextArea',          -- ô nhập nhiều dòng
    'ColorpickerButton', -- ô xem trước màu
    'DarknessPicker',    -- thanh chọn độ sáng của bảng màu
    'RGBPicker'          -- bảng chọn màu
}

local function IsProtected(Item)
    local N = Item.Name
    for _, S in ipairs(ProtectedSuffix) do
        if N:sub(-#S) == S then
            return true
        end
    end
    return false
end

-- độ trong RIÊNG của từng khung (nil = theo thanh Transparency chung)
local PanelT = {}   -- ví dụ PanelT.SearchBar = 0.4

local function ResolveT(Item, T)
    for PanelName, V in next, PanelT do
        if Item.Name == PanelName or Item:FindFirstAncestor(PanelName) then
            return V
        end
    end
    return T
end

