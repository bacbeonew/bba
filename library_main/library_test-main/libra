    -- Set: chế độ đơn nhận 1 tên, chế độ nhiều nhận mảng (hoặc bảng {tên = true})
    function DropdownFunctions:Set(Value)
        if Multi then
            LoadSelection(Value)
            local Chosen = RefreshMulti()
            Config[Name] = Chosen
            Callback(Chosen)
            return
        end
        SelectedItem = tostring(Value)
        DropdownSelectedText.Text = tostring(Value)
        Callback(Value)
    end
    ConfigUpdates[Name] = DropdownFunctions

    -- đưa dropdown về trạng thái "chưa chọn gì" (không gọi Callback)
function DropdownFunctions:Reset()
    SelectedItem = 'None'
    if Multi then
        Selected = {}
        Config[Name] = {}
        RefreshMulti()
    else
        Config[Name] = nil
        DropdownSelectedText.Text = 'None'
        for _, B in next, DropList:GetChildren() do
            if B:IsA('TextButton') then
                Utility:Tween(B, {BackgroundColor3 = Theme.PrimaryElementColor}, 0.25)
            end
        end
    end
end




    function DropdownFunctions:UpdateDropdown(NewList)
        task.wait(0.25)
        local NewList = NewList or {}
        if Opened then
            Opened = false
            Utility:Tween(DropdownFiller, {Size = UDim2.new(0, 410, 0, 0)}, 0.25)
            Utility:Tween(DropList, {Size = UDim2.new(0, 410, 0, 0)}, 0.25)
            Utility:Tween(DropdownIcon, {Rotation = 270}, 0.25)
            if #List <= 5 then
                Utility:Tween(Tab, {CanvasSize = Tab.CanvasSize - UDim2.new(0, 0, 0, ListH())}, 0.25)
                Utility:Tween(Section, {Size = Section.Size - UDim2.new(0, 0, 0, ListH())}, 0.25)
            else
                Utility:Tween(Tab, {CanvasSize = Tab.CanvasSize - UDim2.new(0, 0, 0, 150)}, 0.25)
                Utility:Tween(Section, {Size = Section.Size - UDim2.new(0, 0, 0, 150)}, 0.25)
            end
            DropList.Visible = false
            DropdownFiller.Visible = false
        end
        task.wait(0.25)
        for _, Item in next, DropList:GetChildren() do
            if Item:IsA('TextButton') then
                Item:Destroy()
            end
        end
        List = Prep(NewList)

        if Multi then
            for K in pairs(Selected) do
                if not table.find(List, K) then Selected[K] = nil end
            end
        end

        for _, Item in next, List do
            MakeOption(Item)
            UpdateSectionSize()
        end

        if Multi then
            RefreshMulti()
        elseif #List == 0 then
            DropdownSelectedText.Text = 'None'
            SelectedItem = 'None'
        end
    end
    return DropdownFunctions
end



