local function MoveTooltip()
    if not TooltipFrame then return end
    local Mouse = UserInputService:GetMouseLocation()
    local Inset = Container.IgnoreGuiInset and Vector2.new(0, 0) or GuiService:GetGuiInset()
    local View = workspace.CurrentCamera.ViewportSize
    local Size = TooltipFrame.AbsoluteSize

    local X = math.min(Mouse.X + 14, View.X - Size.X - 4)
    local Y = Mouse.Y - Inset.Y + 18
    if Y + Size.Y > View.Y - 4 then
        Y = Mouse.Y - Inset.Y - Size.Y - 10     -- hết chỗ phía dưới thì hiện phía trên con trỏ
    end
    TooltipFrame.Position = UDim2.fromOffset(math.max(X, 4), math.max(Y, 4))
end

-- Text = nội dung gợi ý, Key = chữ phím (chuỗi) hoặc hàm trả về chữ phím; cả hai đều tùy chọn
function Library:AttachTooltip(Object, Text, Key)
    if not Object then return end
    if (Text == nil or Text == '') and Key == nil then return end

    local Hovering = false

    Object.MouseEnter:Connect(function()
        Hovering = true
        TooltipToken = TooltipToken + 1
        local Token = TooltipToken

        task.delay(0.35, function()
            if not Hovering or Token ~= TooltipToken then return end
            BuildTooltip()

            local Body = ''
            if Text and Text ~= '' then
                Body = tostring(Text):gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;')
            end
            local KeyName = type(Key) == 'function' and Key() or Key
            if KeyName and tostring(KeyName) ~= '' then
                local Line = string.format('<font color="#%s">Keybind: [%s]</font>',
                    Theme.SecondaryTextColor:ToHex(), tostring(KeyName))
                Body = (Body ~= '' and (Body..'\n') or '')..Line
            end

            TooltipLabel.Text = Body
            TooltipLabel.TextColor3 = Theme.PrimaryTextColor
            TooltipFrame.BackgroundColor3 = Theme.PromptColor
            TooltipFrame.TooltipStroke.Color = Theme.UIStrokeColor
            TooltipFrame.Visible = true
            MoveTooltip()

            if TooltipConn then TooltipConn:Disconnect() end
            TooltipConn = RunService.RenderStepped:Connect(function()
                if not Hovering or not TooltipFrame or not TooltipFrame.Parent then
                    if TooltipConn then TooltipConn:Disconnect() TooltipConn = nil end
                    return
                end
                MoveTooltip()
            end)
        end)
    end)

    Object.MouseLeave:Connect(function()
        Hovering = false
        TooltipToken = TooltipToken + 1
        if TooltipFrame then TooltipFrame.Visible = false end
        if TooltipConn then TooltipConn:Disconnect() TooltipConn = nil end
    end)
end
