local CurrentTransparency = 0
local FadeHooked = false

local FadeBlacklist = {
    UIPadding = true, UICorner = true, UIStroke = true,
    UIListLayout = true, UIScale = true, Folder = true
}

-- ===== NỀN GROUP =====
local GroupBgT = nil          -- nil = theo thanh Transparency chung
