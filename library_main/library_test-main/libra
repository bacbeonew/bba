--     if FadeBlacklist[Item.ClassName] or IsProtected(Item) then return end
--     if Item.BackgroundTransparency < 0.999 then          -- khung không nền (=1) thì bỏ qua
--         Item.BackgroundTransparency = ResolveT(Item, T)
--     end
-- end

local function FadeItem(Item, T)
    if not Item:IsA('GuiObject') then return end
    -- khung nền của group: dùng độ trong riêng nếu có
    if Item:GetAttribute('IsGroup') and GroupBgT ~= nil then
        Item.BackgroundTransparency = GroupBgT
        return
    end
    if FadeBlacklist[Item.ClassName] or IsProtected(Item) then return end
    if Item.BackgroundTransparency < 0.999 then
        Item.BackgroundTransparency = ResolveT(Item, T)
    end
end

-- chỉnh độ trong riêng cho 1 khung: "SearchBar" hoặc "KeybindPanel"
function Library:SetPanelTransparency(PanelName, Transparency)
    PanelT[PanelName] = math.clamp(tonumber(Transparency) or 0, 0, 0.95)
    Library:SetTransparency(CurrentTransparency)         -- áp lại cho toàn UI
end

function Library:SetTransparency(Transparency, NotificationBool)
    local UI = CoreGui:WaitForChild(UIName)
    local T = math.clamp(tonumber(Transparency) or 0, 0, 0.95)
    CurrentTransparency = T

    for _, Item in next, UI:GetDescendants() do
        FadeItem(Item, T)
    end

    -- khung được tạo SAU này (dropdown, kết quả tìm kiếm, tooltip...) cũng mờ theo
    if not FadeHooked then
        FadeHooked = true
        UI.DescendantAdded:Connect(function(Item)
            task.defer(function()
                if Item.Parent and (CurrentTransparency > 0 or next(PanelT)) then
                    FadeItem(Item, CurrentTransparency)
                end
            end)
        end)
    end

    if NotificationBool then
        NotificationTransparency = T      -- khung prompt/thông báo không bị tàng hình
    end
end

-- Chẩn đoán: in ra các khung còn đặc (BackgroundTransparency < 0.5)
function Library:DebugTransparency()
    local UI = CoreGui:FindFirstChild(UIName)
    if not UI then return end
    local Count = 0
    for _, Item in next, UI:GetDescendants() do
        if Item:IsA('GuiObject') and Item.BackgroundTransparency < 0.5 then
            Count = Count + 1
            print(string.format('%s > %s  (T=%.2f)%s',
                Item.Parent and Item.Parent.Name or '?', Item.Name,
                Item.BackgroundTransparency, IsProtected(Item) and '  [protected]' or ''))
        end
    end
    print('Opaque items:', Count)
end
