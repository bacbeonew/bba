    local function StartStats()
        if StatsConnection then StatsConnection:Disconnect() end
        local Frames, Last = 0, os.clock()
        StatsConnection = RunService.RenderStepped:Connect(function()
            if not MiniBar.Parent then
                StatsConnection:Disconnect()
                return
            end
            Frames = Frames + 1
            local Now = os.clock()
            if Now - Last >= 0.5 then
                local Fps = math.floor(Frames / (Now - Last) + 0.5)
                local Ping = 0
                pcall(function()
                    Ping = math.floor(StatsService.Network.ServerStatsItem['Data Ping']:GetValue() + 0.5)
                end)
                MiniStats.Text = 'FPS: '..Fps..' | Ping: '..Ping..'ms'
                Frames, Last = 0, Now
            end
        end)
    end

    local function SetMinimized(State)
        if State == IsMinimized or MinimizeBusy then return end
        MinimizeBusy = true
        IsMinimized = State
        DragButton.Visible = not State
        if State then
            FullSize = Main.Size
            Main.ClipsDescendants = true
            -- 1) co chiều cao thành thanh mỏng
            Utility:Tween(Main, {Size = UDim2.new(0, FullSize.X.Offset, 0, 2)}, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.wait(0.25)
            -- 2) 2 đầu thanh kéo vào giữa
            Utility:Tween(Main, {Size = UDim2.new(0, 0, 0, 2)}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.wait(0.2)
            Main.Visible = false
            Main.ClipsDescendants = false

            MiniBar.Position = MiniHidden
            MiniBar.Visible = true
            StartStats()
            Utility:Tween(MiniBar, {Position = MiniShown}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            task.wait(0.35)
        else
            Utility:Tween(MiniBar, {Position = MiniHidden}, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.wait(0.25)
            MiniBar.Visible = false
            if StatsConnection then
                StatsConnection:Disconnect()
                StatsConnection = nil
            end

            Main.Size = UDim2.new(0, 0, 0, 2)
            Main.Visible = true
            Main.ClipsDescendants = true
            -- 1) thanh mỏng giãn ra 2 bên
            Utility:Tween(Main, {Size = UDim2.new(0, FullSize.X.Offset, 0, 2)}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            task.wait(0.2)
            -- 2) mở chiều cao
