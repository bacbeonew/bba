local function SetSliderValue(Value)
    local Number = tonumber(Value)

    if not Number then
        SliderNumber.Text = tostring(CurrentValue)
        return
    end

    Number = math.clamp(
        math.floor(Number),
        MinimumValue,
        MaximumValue
    )

    CurrentValue = Number

    local Fraction = 0

    if MaximumValue ~= MinimumValue then
        Fraction = (Number - MinimumValue) /
            (MaximumValue - MinimumValue)
    end

    SliderNumber.Text = tostring(Number)
    Config[Name] = Number

    Utility:Tween(
        SliderTrail,
        {Size = UDim2.new(Fraction, 0, 0, 10)},
        0.15
    )

    task.spawn(function()
        Callback(CurrentValue)
    end)
end

