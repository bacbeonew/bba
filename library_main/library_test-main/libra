local function RefreshKbPanel()
    if not KbBody or not KbBody.Parent then return end
    for _, E in ipairs(KeybindEntries) do
        if not E.Row then BuildKbRow(E) end
        local Ok, Key = pcall(E.GetKey)
        E.KeyLabel.Text = (Ok and Key and tostring(Key) ~= '') and tostring(Key) or 'None' --'?'
        E.KeyLabel.BackgroundColor3 = Theme.SecondaryElementColor
        E.KeyLabel.TextColor3 = Theme.SecondaryTextColor
        local On = false
        if E.GetState then
            local Ok2, State = pcall(E.GetState)
            On = Ok2 and State == true
        end
        E.NameLabel.TextColor3 = On and KbAccent or Theme.PrimaryTextColor
    end
    KbEmpty.Visible = #KeybindEntries == 0
end

