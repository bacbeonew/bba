function Library:ImportConfig(Json, Name)
    Name = tostring(Name or ''):gsub('[^%w%-%_ ]', '')
    if Name == '' then
        Library:CreateNotification('Import Failed', 'Please type a config name first.', 5)
        return false
    end

    local Ok, Decoded = pcall(function()
        return HttpService:JSONDecode(Json or '')
    end)
    if not Ok or type(Decoded) ~= 'table' then
        Library:CreateNotification('Import Failed', 'The pasted text is not a valid config.', 5)
        return false
    end

    if not isfolder(ConfigF) then makefolder(ConfigF) end

    local Path = ConfigF..'/'..Name..'.json'
    local Encoded = HttpService:JSONEncode(Decoded)

    local function Finish()
        writefile(Path, Encoded)
        Library:CreateNotification('Config Imported', 'Saved as \''..Name..'.json\'.', 5)
        NotifyConfigsChanged()
        -- đợi prompt Overwrite đóng xong (~0.8s) rồi mới hỏi Load, tránh 2 prompt đè nhau
        task.delay(1, function()
            Library:LoadConfig(Name)
        end)
    end

    if isfile(Path) then
        Library:CreatePrompt('TwoButton', 'Overwrite Config',
            'A config named \''..Name..'\' already exists. Overwrite it with the imported config?', {
            'No',
            function()
                Library:CreateNotification('Import Cancelled', 'Existing config was kept.', 5)
            end,
            'Yes',
            Finish
        })
    else
        Finish()
    end
    return true
end






