local function AutoScrollIntoView(Target)
    task.spawn(function()
        task.wait(0.35)

        if not Target or not Target.Parent then return end
        if not Tab or not Tab.Parent then return end

        local Scale = MainScale.Scale
        if Scale <= 0 then Scale = 1 end

        local ViewBottom = Tab.AbsolutePosition.Y + Tab.AbsoluteSize.Y
        local TargetBottom = Target.AbsolutePosition.Y + Target.AbsoluteSize.Y

        local Overflow = TargetBottom - ViewBottom

        if Overflow > 0 then
            local MaxScroll = math.max(
                0,
                Tab.AbsoluteCanvasSize.Y - Tab.AbsoluteWindowSize.Y
            )

            local NewY = math.min(
                MaxScroll,
                Tab.CanvasPosition.Y + Overflow / Scale + 8
            )

            Tab.CanvasPosition = Vector2.new(
                Tab.CanvasPosition.X,
                NewY
            )
        end
    end)
end







